# Template for Streamlit Community Cloud's Secrets manager.
#
# Do NOT fill this file in and commit it -- it is only here so you know
# exactly what to paste into the real secrets box on the Streamlit Cloud
# website (App -> Settings -> Secrets), which never touches git at all.
# See docs/deployment_guide.md, Step 4, for the walkthrough.
#
# Streamlit Cloud automatically exposes any ROOT-LEVEL key here (like
# DATABASE_URL below) as a regular environment variable to the running
# app -- which is exactly what config/settings.py already reads via
# os.environ.get("DATABASE_URL", ...). No code changes are needed to use
# this; the same DATABASE_URL mechanism that works with a local .env file
# also works with Streamlit Cloud secrets.

DATABASE_URL = "postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME"
