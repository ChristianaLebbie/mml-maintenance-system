# Copy this file to .env and adjust values as needed.
# Nothing here is a secret for the thesis prototype (SQLite, local files),
# but the pattern is kept so the system can move to managed credentials later.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite path is relative to the project root)
DATABASE_URL=sqlite:///database/predictive_maintenance.db

# Optional future real-time / external service credentials go here.
# Never commit a real .env file.
